# Configuration du LinkedIn Research Agent.
# Copier en `.env` (jamais versionné) et renseigner API_KEY.

# --- Service ---
# 127.0.0.1 par défaut : le service ne doit pas être joignable depuis le réseau
# sans décision explicite (EXPOSE_PUBLIC=1 + BIND_HOST=0.0.0.0).
BIND_HOST=127.0.0.1
PORT=9100
# EXPOSE_PUBLIC=1

# --- Authentification ---
# Obligatoire : le service refuse de démarrer sans cette valeur.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Couper l'authentification n'est possible qu'en boucle locale.
# AUTH_ENABLED=0

# --- CORS ---
# Liste explicite, séparée par des virgules. Vide = aucune origine tierce.
CORS_ORIGINS=

# --- Sources joignables (liste blanche d'hôtes) ---
ALLOWED_SOURCE_HOSTS=www.wikidata.org,fr.wikipedia.org,en.wikipedia.org,api.linkedin.com

# --- Recherche LinkedIn (API officielle uniquement, jamais de scraping) ---
# LINKEDIN_TOKEN=

# --- Limites ---
RATE_LIMIT_PER_MINUTE=30
MAX_QUERY_LENGTH=160

# --- Enregistrement auprès d'un orchestrateur (register.py) ---
ORCHESTRATOR_URL=http://127.0.0.1:8000
ORCH_KEY=
AGENT_ENDPOINT=http://127.0.0.1:9100
HEARTBEAT_SECONDS=10
